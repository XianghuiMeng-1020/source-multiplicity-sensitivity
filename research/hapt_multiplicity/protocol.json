    "extracted_root": "data/raw/hapt_extracted",
    "features_txt": "data/raw/hapt_extracted/features.txt",
    "features_txt_sha256": "bd297980ae769f576fe3b796936b17542e8825df967d6f475ac6214b31bc2fc5",
    "feature_map": "research/hapt_multiplicity/feature_map.json",
    "feature_map_sha256_at_preregistration": "f1deccb0aa31346c40a9483f15c502b07dd1957099a909a0357e864e2818a4c2"
  },
  "sources": {
    "M1": "accelerometer-family engineered features",
    "M2": "gyroscope-family engineered features",
    "M1_n": 348,
    "M2_n": 211,
    "excluded_n": 2,
    "excluded_names": [
      "tBodyGyro-AngleWRTGravity-1",
      "tBodyGyroJerk-AngleWRTGravity-1"
    ],
    "excluded_indices": [556, 557],
    "identity": "348 + 211 + 2 = 561; M1 and M2 disjoint; union plus exclusions equals all official columns",
    "not_used": "src.datasets._group_hapt_features acc/gyro/other"
  },
  "split": {
    "train_files": [
      "data/raw/hapt_extracted/Train/X_train.txt",
      "data/raw/hapt_extracted/Train/y_train.txt",
      "data/raw/hapt_extracted/Train/subject_id_train.txt"
    ],
    "test_files": [
      "data/raw/hapt_extracted/Test/X_test.txt",
      "data/raw/hapt_extracted/Test/y_test.txt",
      "data/raw/hapt_extracted/Test/subject_id_test.txt"
    ],
    "expected_train_n": 7767,
    "expected_test_n": 3162,
    "expected_train_subjects": 21,
    "expected_test_subjects": 9,
    "subject_disjoint": true,
    "n_classes": 12,
    "label_map": "official 1..12 minus 1 -> 0..11"
  },
  "seeds": [0, 1, 2],
  "holdout": {
    "fraction": 0.2,
    "unit": "official training windows, not subjects",
    "method": "numpy default_rng(seed).permutation(n_train); first int(0.2*n) are CPSA holdout; remainder train both encoders",
    "not_independent_subject_validation": true,
    "test_never_enters_holdout": true
  },
  "preprocessing": {
    "dataset_provided_feature_scaling": true,
    "additional_fitted_scaling": false,
    "no_z_standardization": true,
    "no_minmax_fitting": true,
    "no_pca": true,
    "no_label_based_feature_selection": true,
    "no_test_statistic_normalization": true,
    "no_class_resampling": true,
    "released_features_bounded_minus1_1": true,
    "author_scaling_train_only": "UNVERIFIED from local documentation; do not claim"
  },
  "encoder": {
    "family": "MLP d -> 128 -> 128 -> 12 ReLU, same as src.models.MLP",
    "loss": "CrossEntropyLoss on logits",
    "optimizer": "Adam",
    "lr": 0.001,
    "epochs": 25,
    "batch_size": 128,
    "seed_M1": "seed",
    "seed_M2": "seed + 1",
    "device": "cpu",
    "no_test_early_stopping": true,
    "no_hapt_hyperparameter_search": true
  },
  "cpsa": {
    "architecture": "ContextualPSA phi 12->16 ReLU; g([h,c,|h-c|]) 48->16->1; softmax attention; weighted sum of tokens",
    "n_tokens_train": 2,
    "tokens": "[p1, p2] from encoder-eval on CPSA holdout only",
    "no_modality_ids": true,
    "no_duplicate_tokens_in_training": true,
    "no_corrupted_tokens_in_training": true,
    "optimizer": "Adam",
    "lr": 0.001,
    "epochs": 25,
    "batch_size": 128,
    "seed": "seed + 10",
    "device": "cpu",
    "expected_parameter_count": 1009,
    "loss": "cross_entropy(log(clamp(fused, 1e-8)), y)",
    "phase4_three_token_trainer_unmodified": true
  },
  "metrics": [
    "accuracy",
    "ece_15",
    "nll",
    "multiclass_brier",
    "mean_confidence",
    "confidence_minus_accuracy",
    "mean_entropy",
    "macro_f1",
    "balanced_accuracy",
    "per_class_recall"
  ],
  "clean_eval_objects": ["M1", "M2", "late_product", "late_mean", "cpsa"],
  "no_k_greater_than_1": true,
  "device_inference": "cpu",
  "map_location": "cpu",
  "freeze_replay": {
    "write_root": "research/hapt_multiplicity/results",
    "checkpoints_per_seed": ["enc_M1", "enc_M2", "cpsa"],
    "cache_per_seed": ["p1_test", "p2_test", "y_test", "subject_test", "fused_late_product", "fused_late_mean", "fused_cpsa"],
    "replay": "inference only from official HAPT files + frozen checkpoints + frozen feature map",
    "match_categories": ["EXACT", "NUMERICAL_MATCH<=1e-7", "CLOSE_ONLY<=1e-5", "FAIL>1e-5"],
    "pass_requires_zero_fail_cells": true
  }
}
